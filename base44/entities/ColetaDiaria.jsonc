{
  "name": "ColetaDiaria",
  "type": "object",
  "properties": {
    "numero_coleta": {
      "type": "string",
      "description": "N\u00famero sequencial da coleta"
    },
    "data_coleta": {
      "type": "string",
      "format": "date",
      "description": "Data da coleta"
    },
    "remetente_id": {
      "type": "string",
      "description": "ID do cliente remetente"
    },
    "remetente_nome": {
      "type": "string",
      "description": "Nome do remetente"
    },
    "remetente_fantasia": {
      "type": "string",
      "description": "Nome fantasia do remetente"
    },
    "remetente_endereco": {
      "type": "string",
      "description": "Endere\u00e7o do remetente"
    },
    "remetente_bairro": {
      "type": "string",
      "description": "Bairro do remetente"
    },
    "remetente_cidade": {
      "type": "string",
      "description": "Cidade do remetente"
    },
    "remetente_cep": {
      "type": "string",
      "description": "CEP do remetente"
    },
    "remetente_telefone": {
      "type": "string",
      "description": "Telefone do remetente"
    },
    "remetente_horario": {
      "type": "string",
      "description": "Hor\u00e1rio de funcionamento"
    },
    "remetente_intervalo": {
      "type": "string",
      "description": "Hor\u00e1rio de intervalo"
    },
    "destinatario_id": {
      "type": "string",
      "description": "ID do cliente destinat\u00e1rio"
    },
    "destinatario_nome": {
      "type": "string",
      "description": "Nome do destinat\u00e1rio"
    },
    "destinatario_fantasia": {
      "type": "string",
      "description": "Nome fantasia do destinat\u00e1rio"
    },
    "motorista_id": {
      "type": "string",
      "description": "ID do motorista"
    },
    "volume": {
      "type": "string",
      "description": "Volume da carga"
    },
    "peso": {
      "type": "string",
      "description": "Peso da carga"
    },
    "nfe": {
      "type": "string",
      "description": "N\u00famero da NFe"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "realizado",
        "cancelado"
      ],
      "default": "pendente",
      "description": "Status da coleta"
    },
    "prioridade": {
      "type": "boolean",
      "default": false,
      "description": "Se a coleta \u00e9 priorit\u00e1ria"
    },
    "recado": {
      "type": "string",
      "description": "Recado ou observa\u00e7\u00e3o"
    },
    "ordem": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o da coleta"
    }
  },
  "required": [
    "data_coleta",
    "remetente_nome",
    "destinatario_nome"
  ]
}