{
  "name": "Empresa",
  "type": "object",
  "properties": {
    "razao_social": {
      "type": "string",
      "description": "Raz\u00e3o social da empresa"
    },
    "nome_fantasia": {
      "type": "string",
      "description": "Nome fantasia"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ da empresa"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone de contato"
    },
    "email": {
      "type": "string",
      "description": "Email principal da empresa"
    },
    "logo_url": {
      "type": "string",
      "description": "URL do logotipo da empresa"
    },
    "status": {
      "type": "string",
      "enum": [
        "trial",
        "ativa",
        "suspensa",
        "bloqueada",
        "cancelada"
      ],
      "default": "trial",
      "description": "Status da empresa no SaaS"
    },
    "plano": {
      "type": "string",
      "enum": [
        "trial",
        "mensal",
        "anual",
        "personalizado"
      ],
      "default": "trial",
      "description": "Plano contratado"
    },
    "data_inicio_trial": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio do trial"
    },
    "data_vencimento": {
      "type": "string",
      "format": "date",
      "description": "Data de vencimento do plano/trial"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se a empresa est\u00e1 ativa no sistema"
    }
  },
  "required": [
    "razao_social",
    "status"
  ]
}