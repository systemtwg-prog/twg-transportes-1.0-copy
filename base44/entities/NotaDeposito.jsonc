{
  "name": "NotaDeposito",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo ou descri\u00e7\u00e3o"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data da nota"
    },
    "foto_url": {
      "type": "string",
      "description": "URL da foto"
    },
    "fotos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "tipo": {
            "type": "string"
          }
        }
      },
      "description": "Lista de fotos"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "finalizado"
      ],
      "default": "pendente",
      "description": "Status da nota"
    },
    "usuario_foto": {
      "type": "string",
      "description": "Nome do usu\u00e1rio que tirou a foto"
    },
    "nota_fiscal": {
      "type": "string",
      "description": "N\u00famero da nota fiscal"
    },
    "cadastrada": {
      "type": "boolean",
      "default": false,
      "description": "Se a nota foi cadastrada no sistema"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "data"
  ]
}