{
  "name": "OrdemColeta",
  "type": "object",
  "properties": {
    "numero": {
      "type": "string",
      "description": "N\u00famero da ordem"
    },
    "data_ordem": {
      "type": "string",
      "format": "date",
      "description": "Data da ordem"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "em_andamento",
        "coletado",
        "entregue",
        "cancelado"
      ],
      "default": "pendente",
      "description": "Status da coleta"
    },
    "remetente_id": {
      "type": "string",
      "description": "ID do cliente remetente"
    },
    "remetente_nome": {
      "type": "string",
      "description": "Nome do remetente"
    },
    "remetente_codigo": {
      "type": "string",
      "description": "C\u00f3digo do remetente"
    },
    "remetente_contato": {
      "type": "string",
      "description": "Contato do remetente"
    },
    "remetente_cep": {
      "type": "string",
      "description": "CEP do remetente"
    },
    "remetente_endereco": {
      "type": "string",
      "description": "Endere\u00e7o do remetente"
    },
    "remetente_cnpj": {
      "type": "string",
      "description": "CNPJ do remetente"
    },
    "remetente_bairro": {
      "type": "string",
      "description": "Bairro do remetente"
    },
    "remetente_cidade": {
      "type": "string",
      "description": "Cidade do remetente"
    },
    "remetente_telefone": {
      "type": "string",
      "description": "Telefone do remetente"
    },
    "remetente_obs": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es do remetente"
    },
    "destinatario_id": {
      "type": "string",
      "description": "ID do cliente destinat\u00e1rio"
    },
    "destinatario_nome": {
      "type": "string",
      "description": "Nome do destinat\u00e1rio"
    },
    "destinatario_codigo": {
      "type": "string",
      "description": "C\u00f3digo do destinat\u00e1rio"
    },
    "destinatario_contato": {
      "type": "string",
      "description": "Contato do destinat\u00e1rio"
    },
    "destinatario_telefone": {
      "type": "string",
      "description": "Telefone do destinat\u00e1rio"
    },
    "destinatario_cnpj": {
      "type": "string",
      "description": "CNPJ do destinat\u00e1rio"
    },
    "destinatario_ref_obs": {
      "type": "string",
      "description": "Refer\u00eancia/Obs do destinat\u00e1rio"
    },
    "peso": {
      "type": "string",
      "description": "Peso da carga"
    },
    "volume": {
      "type": "string",
      "description": "Quantidade de volumes"
    },
    "especie": {
      "type": "string",
      "description": "Esp\u00e9cie da carga"
    },
    "data_coleta": {
      "type": "string",
      "format": "date",
      "description": "Data da coleta"
    },
    "nfe": {
      "type": "string",
      "description": "N\u00famero da NFe"
    },
    "solicitante": {
      "type": "string",
      "description": "Quem solicitou"
    },
    "horario": {
      "type": "string",
      "description": "Hor\u00e1rio da coleta"
    },
    "almoco": {
      "type": "string",
      "description": "Intervalo de almo\u00e7o"
    },
    "motorista_id": {
      "type": "string",
      "description": "ID do motorista"
    },
    "motorista": {
      "type": "string",
      "description": "Nome do motorista"
    },
    "veiculo_id": {
      "type": "string",
      "description": "ID do ve\u00edculo"
    },
    "placa": {
      "type": "string",
      "description": "Placa do ve\u00edculo"
    },
    "cpf_motorista": {
      "type": "string",
      "description": "CPF do motorista"
    },
    "localizacao_latitude": {
      "type": "number",
      "description": "Latitude atual do motorista"
    },
    "localizacao_longitude": {
      "type": "number",
      "description": "Longitude atual do motorista"
    },
    "localizacao_atualizada_em": {
      "type": "string",
      "description": "Data/hora da \u00faltima atualiza\u00e7\u00e3o de localiza\u00e7\u00e3o"
    },
    "notificacao_enviada": {
      "type": "boolean",
      "default": false,
      "description": "Se notifica\u00e7\u00e3o foi enviada"
    }
  },
  "required": [
    "numero",
    "data_ordem",
    "remetente_nome",
    "destinatario_nome"
  ]
}