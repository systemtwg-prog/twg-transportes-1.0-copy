{
  "name": "User",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "aprovado",
        "rejeitado"
      ],
      "default": "pendente",
      "description": "Status de aprova\u00e7\u00e3o do usu\u00e1rio"
    },
    "tipo_usuario": {
      "type": "string",
      "enum": [
        "admin",
        "usuario"
      ],
      "default": "usuario",
      "description": "Tipo de usu\u00e1rio"
    },
    "paginas_permitidas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de p\u00e1ginas que o usu\u00e1rio tem acesso"
    }
  },
  "required": [
    "paginas_permitidas"
  ]
}