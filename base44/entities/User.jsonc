{
  "name": "User",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "aprovado",
        "rejeitado"
      ],
      "default": "pendente",
      "description": "Status de aprova\u00e7\u00e3o do usu\u00e1rio"
    },
    "tipo_usuario": {
      "type": "string",
      "enum": [
        "admin",
        "usuario",
        "proprietario"
      ],
      "default": "usuario",
      "description": "Tipo de usu\u00e1rio dentro da empresa"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user",
        "proprietario"
      ],
      "default": "user",
      "description": "Role do usu\u00e1rio (built-in + estendido)"
    },
    "paginas_permitidas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de p\u00e1ginas que o usu\u00e1rio tem acesso"
    },
    "empresa_id": {
      "type": "string",
      "description": "ID da empresa (tenant) \u00e0 qual o usu\u00e1rio pertence. Null para o propriet\u00e1rio da plataforma."
    },
    "is_proprietario": {
      "type": "boolean",
      "default": false,
      "description": "Se o usu\u00e1rio \u00e9 o propriet\u00e1rio da plataforma (super-admin, v\u00ea todas as empresas)"
    },
    "active_empresa_id": {
      "type": "string",
      "description": "Empresa atualmente selecionada pelo propriet\u00e1rio para visualiza\u00e7\u00e3o (apenas para is_proprietario)"
    }
  },
  "required": [
    "paginas_permitidas"
  ]
}